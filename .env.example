SAFEJUDGE_ENVIRONMENT=development
SAFEJUDGE_LOG_LEVEL=INFO
SAFEJUDGE_DATA_DIR=./data
SAFEJUDGE_ARTIFACT_DIR=./artifacts
SAFEJUDGE_MAX_CONCURRENCY=4

# M2 OpenRouter。真实密钥只放在本机 .env，不能提交到 Git 或系统环境变量。
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_LOCAL_MEDIA_BYTES=104857600
# 调用时价格快照；按所选模型填写每百万 Token 的美元单价。
OPENROUTER_INPUT_PER_MILLION_TOKENS=0
OPENROUTER_OUTPUT_PER_MILLION_TOKENS=0

# 本地 OpenAI-compatible 服务（LM Studio、Ollama、vLLM 等）。
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL_ID=
# 多数本地服务无需 Key；需要占位 Key 时再填写。
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_TIMEOUT_SECONDS=120
LOCAL_MODEL_MAX_LOCAL_MEDIA_BYTES=104857600

# 本地 OpenAI-compatible Judge/Guardrail 服务；本地 Llama Guard 配置读取此端点。
JUDGE_MODEL_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_MODEL_ID=safejudge-judge
JUDGE_MODEL_API_KEY=local-safejudge
JUDGE_MODEL_TIMEOUT_SECONDS=120
JUDGE_MODEL_MAX_LOCAL_MEDIA_BYTES=104857600

# 后续里程碑启用。
# SAFEJUDGE_DATABASE_URL=postgresql+psycopg://safejudge:safejudge@localhost:5432/safejudge
